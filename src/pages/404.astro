---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/paths';
---

<Layout title="A little off plan">
  <section class="not-found wrap">
    <p class="eyebrow">404 / A little off plan</p>
    <h1>
      This space
      <br />
      is still a blank.
    </h1>
    <p>
      The page you’re looking for isn’t here.
      <br />
      There are other spaces waiting to be explored.
    </p>
    <a class="inline-link" href={url('projects/')}>
      Find your way to the projects <Arrow />
    </a>
  </section>
</Layout>
