---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { url } from '../lib/paths';
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const first = projects[0]!;
---

<Layout>
  <section class="home-intro wrap">
    <p class="eyebrow mobile-kicker">Interiors &amp; spaces</p>
    <h1>Spaces, considered.</h1>
    <p class="intro-copy">
      Interior architecture shaped around
      <br class="desktop-break" /> the way we live.
    </p>
  </section>
  <section class="featured wrap" aria-label="Featured project">
    <a
      class="featured-image"
      href={url(`projects/${first.id}/`)}
      aria-label="01 / Residential — Explore The Courtyard House"
    >
      <Photo name={first.data.cover} alt={first.data.alt} eager />
      <span class="image-label">01 / Residential</span>
    </a>
    <div class="featured-caption">
      <div>
        <p class="eyebrow">The Courtyard House</p>
        <h2>Quiet lines. Open light.</h2>
      </div>
      <a href={url(`projects/${first.id}/`)} class="text-link">
        View project <Arrow circle />
      </a>
    </div>
    <div class="featured-bottom">
      <a href={url('projects/')}>Explore the projects</a>
      <span>
        01 <span class="muted">/ 04</span>
      </span>
      <a href={url('projects/')} aria-label="See all four projects">
        <span aria-hidden="true">⟶</span>
      </a>
    </div>
  </section>
  <section class="studio-intro wrap">
    <p class="eyebrow">A considered approach</p>
    <div>
      <h2>
        Good spaces begin
        <br />
        with paying attention.
      </h2>
      <p>
        To the light at the end of the day. To the materials we reach for. To
        the small rituals that make a place our own.
      </p>
      <p>
        FORMA is an imagined studio exploring interiors that feel quietly,
        unmistakably human.
      </p>
      <a class="inline-link" href={url('studio/')}>
        Meet the studio <Arrow />
      </a>
    </div>
  </section>
  <section class="selected wrap">
    <div class="section-heading">
      <h2>Other perspectives.</h2>
      <a class="inline-link" href={url('projects/')}>
        All projects <Arrow />
      </a>
    </div>
    <div class="projects-grid">
      {projects.slice(1, 3).map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
