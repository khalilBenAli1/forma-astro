---
import { imageUrl } from '../lib/paths';
import { photography, type Photograph } from '../lib/images';
interface Props {
  name: Photograph;
  alt: string;
  eager?: boolean;
  position?: string;
  class?: string;
  sizes?: string;
}
const {
  name,
  alt,
  eager = false,
  position = '50% 50%',
  class: className,
  sizes = '(max-width: 700px) 100vw, 92vw',
} = Astro.props;
---

<img
  class={className}
  src={imageUrl(name)}
  srcset={`${imageUrl(name, 640)} 640w, ${imageUrl(name, 1000)} 1000w, ${imageUrl(name)} 1600w`}
  sizes={sizes}
  width={photography[name].width}
  height={photography[name].height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  style={`object-position:${position};transform-origin:${position}`}
/>
