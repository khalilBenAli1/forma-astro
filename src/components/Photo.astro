---
import { imageUrl } from '../lib/paths';
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  position?: string;
  class?: string;
}
const {
  name,
  alt,
  eager = false,
  position = '50% 50%',
  class: className,
} = Astro.props;
---

<img
  class={className}
  src={imageUrl(name)}
  srcset={`${imageUrl(name, 640)} 640w, ${imageUrl(name, 1000)} 1000w, ${imageUrl(name)} 1600w`}
  sizes="(max-width: 700px) 100vw, 92vw"
  width="1600"
  height="1067"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  style={`object-position:${position};transform-origin:${position}`}
/>
